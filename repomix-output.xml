<file path="public/lv/help.html">
<!DOCTYPE html>
<html lang="lv">

<head>
    <meta name="robots" content="noindex, nofollow">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Shurp | Palīdzība</title>
    <link href="../assets/css/style.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>
    <style>
        :root {
            --c-primary: #125E8A;
            --c-bg: #F3F3F3;
            --c-outline: #E2E8F0;
            --c-text: #1F2933;
            --c-muted: #6B7280;
            --c-surface: #E6F1F7;
            --r-card: 16px;
            --r-pill: 999px;
        }

        .icon-primary {
            filter: invert(27%) sepia(52%) saturate(701%) hue-rotate(172deg) brightness(90%) contrast(98%);
        }

        .icon-muted {
            filter: invert(46%) sepia(6%) saturate(531%) hue-rotate(176deg) brightness(93%) contrast(88%);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html,
        body {
            background: var(--c-bg);
        }

        body {
            color: var(--c-text);
            font-family: 'Inter', sans-serif;
            font-size: 15px;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
            padding-bottom: env(safe-area-inset-bottom, 0px);
        }

        .app-bar {
            position: sticky;
            top: 0;
            z-index: 50;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 52px;
            background: var(--c-bg);
            border-bottom: 1px solid var(--c-outline);
            position: relative;
        }

        .app-bar-title {
            font-size: 18px;
            font-weight: 700;
            color: var(--c-primary);
            letter-spacing: -0.3px;
        }

        .page {
            max-width: 480px;
            margin: 0 auto;
            padding: 0 16px 48px;
        }

        .subtitle {
            text-align: center;
            font-size: 14px;
            color: var(--c-muted);
            padding: 14px 4px 20px;
            line-height: 1.55;
        }

        .section-title {
            font-size: 20px;
            font-weight: 700;
            color: var(--c-text);
            letter-spacing: -0.3px;
            margin-bottom: 10px;
        }

        .card-group {
            background: white;
            border-radius: var(--r-card);
            overflow: hidden;
            margin-bottom: 28px;
            border: 1px solid var(--c-outline);
        }

        .help-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 15px 16px;
            border-bottom: 1px solid var(--c-outline);
            cursor: pointer;
            text-decoration: none;
            color: var(--c-text);
            -webkit-tap-highlight-color: transparent;
            transition: background .1s;
        }

        .help-row:last-child {
            border-bottom: none;
        }

        .help-row:active {
            background: var(--c-surface);
        }

        .row-icon {
            flex-shrink: 0;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .row-icon img {
            width: 20px;
            height: 20px;
            display: block;
        }

        .row-label {
            flex: 1;
            font-size: 15px;
            font-weight: 500;
            color: var(--c-text);
        }

        .row-chevron {
            flex-shrink: 0;
            width: 16px;
            height: 16px;
            display: block;
        }

        .legal-blurb {
            font-size: 14px;
            line-height: 1.65;
            color: var(--c-text);
            text-align: justify;
            margin-bottom: 28px;
        }

        .legal-blurb a {
            color: var(--c-primary);
            font-weight: 600;
            text-decoration: none;
        }

        .legal-blurb a:hover {
            text-decoration: underline;
        }

        .ask-title {
            font-size: 20px;
            font-weight: 700;
            letter-spacing: -0.3px;
            margin-bottom: 14px;
        }

        .form-textarea {
            width: 100%;
            min-height: 100px;
            padding: 14px 16px;
            background: white;
            border: 1.5px solid var(--c-outline);
            border-radius: var(--r-card);
            font-family: 'Inter', sans-serif;
            font-size: 15px;
            color: var(--c-text);
            resize: none;
            outline: none;
            transition: border-color .15s;
            margin-bottom: 10px;
        }

        .form-textarea:focus {
            border-color: var(--c-primary);
        }

        .form-textarea::placeholder {
            color: var(--c-muted);
        }

        .form-input {
            width: 100%;
            padding: 14px 16px;
            background: white;
            border: 1.5px solid var(--c-outline);
            border-radius: var(--r-card);
            font-family: 'Inter', sans-serif;
            font-size: 15px;
            color: var(--c-text);
            outline: none;
            transition: border-color .15s;
            margin-bottom: 6px;
        }

        .form-input:focus {
            border-color: var(--c-primary);
        }

        .form-input.error {
            border-color: #F4937C;
        }

        .form-input.error:focus {
            border-color: #F4937C;
        }

        .form-input::placeholder {
            color: var(--c-muted);
        }

        .form-helper {
            color: var(--c-muted);
            font-size: 12px;
            line-height: 1.4;
            margin: 0 4px 10px;
        }

        .form-helper.error {
            color: #F4937C;
            font-weight: 600;
        }

        .char-counter {
            color: var(--c-muted);
            font-size: 12px;
            margin: -6px 4px 10px;
            text-align: right;
        }

        .turnstile-container {
            height: 0;
            overflow: hidden;
        }

        .form-select-wrapper {
            position: relative;
            margin-bottom: 16px;
        }

        .form-select {
            width: 100%;
            padding: 14px 40px 14px 16px;
            background: white;
            border: 1.5px solid var(--c-outline);
            border-radius: var(--r-card);
            font-family: 'Inter', sans-serif;
            font-size: 15px;
            color: var(--c-muted);
            outline: none;
            appearance: none;
            -webkit-appearance: none;
            cursor: pointer;
            transition: border-color .15s;
        }

        .form-select:focus {
            border-color: var(--c-primary);
        }

        .form-select.filled {
            color: var(--c-text);
        }

        .submit-btn {
            display: block;
            width: 100%;
            padding: 16px;
            background: var(--c-primary);
            color: white;
            font-family: 'Inter', sans-serif;
            font-weight: 700;
            font-size: 16px;
            border: none;
            border-radius: var(--r-pill);
            cursor: pointer;
            transition: opacity .15s;
            margin-bottom: 32px;
            min-height: 48px;
        }

        .submit-btn:active {
            opacity: .82;
        }

        .submit-btn:disabled {
            cursor: wait;
            opacity: .65;
        }

        .success-banner {
            display: none;
            background: #E6F7EE;
            color: #1A7F4B;
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 14px;
            font-weight: 600;
            text-align: center;
            margin-bottom: 16px;
        }

        .success-banner.error {
            background: #FDECEC;
            color: #A13434;
        }

        .mail-fallback {
            display: block;
            color: var(--c-primary);
            font-size: 14px;
            font-weight: 600;
            margin: -18px 0 30px;
            text-align: center;
            text-decoration: none;
        }

        .mil-footer {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .mil-flag {
            display: flex;
            gap: 3px;
        }

        .mil-flag span {
            display: block;
            width: 9px;
            height: 28px;
            border-radius: 3px;
            background: #9E3039;
        }

        .mil-footer p {
            font-size: 13px;
            color: var(--c-muted);
        }

        .overlay {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 100;
            background: var(--c-bg);
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
        }

        .overlay.open {
            display: block;
        }

        .overlay-bar {
            position: sticky;
            top: 0;
            z-index: 10;
            display: flex;
            align-items: center;
            gap: 12px;
            height: 52px;
            padding: 0 16px;
            background: var(--c-bg);
            border-bottom: 1px solid var(--c-outline);
        }

        .back-btn {
