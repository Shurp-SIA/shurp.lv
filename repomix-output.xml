            <button class="back-btn" onclick="closeOverlay('faq-priv')">
                <img src="../assets/icons/icon_back.svg" class="icon-primary" alt="back">
            </button>
            <span class="overlay-title">Data privacy</span>
        </div>
        <div class="overlay-body">
            <div class="faq-item">
                <div class="faq-q" onclick="toggleFaq(this)">What data does Shurp collect?<img
                        src="../assets/icons/icon_left_chevron.svg" class="faq-chevron icon-muted"
